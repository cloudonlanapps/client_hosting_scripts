# @@ROOT_HOST@@ — @@ROLE@@ (@@BRAND@@, @@ENV@@)
# Generated by client_hosting_scripts/web/deploy_web.sh. Port 80 only: `certbot --nginx`
# adds the 443 listener and the http -> https redirect to this file.
server {
    listen 80;
    listen [::]:80;
    server_name @@SERVER_NAMES@@;

    root /var/www/@@ROOT_HOST@@;
    index index.html;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css text/xml text/javascript application/javascript
               application/json application/xml application/wasm image/svg+xml;

    access_log /var/log/nginx/@@ROOT_HOST@@.access.log;
    error_log  /var/log/nginx/@@ROOT_HOST@@.error.log;

    # add_header in a location replaces the server's, so every location below
    # repeats the security headers rather than inheriting them.

    # SPA routing: anything that is not a file is the app's own route.
    # Only main.<ts>.dart.js and flutter_bootstrap.<ts>.js are renamed per
    # build; everything else keeps its name, so it is revalidated every time
    # (a cheap 304 when unchanged) rather than cached blind.
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    }

    # index.html names the current build's bootstrap script: never cache it.
    location = /index.html {
        add_header Cache-Control "no-store" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    }

    # Renamed per build, so a name is never reused: cache for good.
    location ~ ^/(main\.[0-9]+\.dart|flutter_bootstrap\.[0-9]+)\.js$ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header X-Content-Type-Options "nosniff" always;
    }
@@EXTRA_LOCATIONS@@}
