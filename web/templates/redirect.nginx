# @@ROOT_HOST@@ — no website for @@BRAND@@; redirects to @@TARGET_HOST@@ (@@ENV@@)
# Generated by client_hosting_scripts/web/deploy_web.sh. Port 80 only: `certbot --nginx`
# adds the 443 listener to this file.
server {
    listen 80;
    listen [::]:80;
    server_name @@SERVER_NAMES@@;

    access_log /var/log/nginx/@@ROOT_HOST@@.access.log;
    error_log  /var/log/nginx/@@ROOT_HOST@@.error.log;

    # Inside a location, not at server level, so certbot's exact-match
    # challenge location still wins while it issues the certificate.
    location / {
        return 301 https://@@TARGET_HOST@@$request_uri;
    }
}
